# Pinned versions and checksums for everything the GPU hosts download.
# Sourced by infra/machine-setup.sh and read by docs/SETUP.md. Re-verify before every workshop.
# Verified 2026-10-14 against the publishers' own checksum files.

# Inference engine: official vLLM image. The tag is mutable on Docker Hub; the digest is not.
VLLM_IMAGE_TAG="vllm/vllm-openai:v0.31.0"
VLLM_IMAGE_DIGEST="sha256:c1c9f6fd5c109ba7f0546a59f5b2f15fb87f64c77782e90a27b648b42a8e67c3"

# Monitoring binaries used on the pods (pods cannot run Docker, so we run the processes directly).
PROMETHEUS_VERSION="3.15.0"
PROMETHEUS_URL="https://github.com/prometheus/prometheus/releases/download/v3.15.0/prometheus-3.15.0.linux-amd64.tar.gz"
PROMETHEUS_SHA256="2a542df32eac02ee17b9d844fb2aa1de00dafa5476579ba8a3ba862e9d572ea0"

GRAFANA_VERSION="13.2.4"
GRAFANA_URL="https://dl.grafana.com/oss/release/grafana-13.2.4.linux-amd64.tar.gz"
GRAFANA_SHA256="c48765988fd88572607e4ea670251af8a8e64ab3e360d0f3cf67a6f3587b92ab"
