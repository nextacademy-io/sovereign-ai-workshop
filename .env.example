# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Hugging Face token. Only needed for gated models. The default workshop models
# (Qwen, Apache-2.0) download anonymously, but a token raises rate limits.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key the shared vLLM server requires (vllm serve --api-key). Generate one
# per workshop run, e.g.:  python3 -c "import secrets; print('wk-' + secrets.token_urlsafe(24))"
VLLM_API_KEY=wk-change-me

# Participant-side: endpoint and model name used by apps/ and benchmark/.
# Over an SSH tunnel (ssh -L 8000:127.0.0.1:8000 <user>@<host> -p <port>):
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=${VLLM_API_KEY}
WORKSHOP_MODEL=Qwen/Qwen3-8B

# Trainer-side only (GPU provisioning). The Runpod MCP server authenticates via
# OAuth, so this is only needed for the REST scripts in infra/runpod/.
# RUNPOD_API_KEY=
